# Aiven Console > Connection information > Service URI
# Parolayı bu dosyaya yazma; Render Environment Variables içinde Secret olarak gir.
MYSQL_URI=mysql://USER:PASSWORD@HOST:PORT/defaultdb?ssl-mode=REQUIRED

# Frontend adreslerini virgülle ayır.
# Örnek: https://cigkofte-frontend.vercel.app,https://www.siteadiniz.com
CORS_ALLOWED_ORIGINS=

# Frontend farklı domaindeyse bu ikisi açık kalmalı.
SESSION_SECURE=true
SESSION_SAMESITE=None

# Aiven CA dosyasını Render Secret File olarak yüklersen path'i buraya gir.
# ssl-mode=REQUIRED için çoğu durumda MYSQL_URI yeterlidir; verify-ca istiyorsan CA kullan.
DB_SSL_CA_PATH=
